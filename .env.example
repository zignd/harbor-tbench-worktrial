# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit real keys.
#
# Load it for any command with:  uv run --env-file .env <command>
#   e.g.  uv run --env-file .env harbor run -p output/<task> -a oracle

# Inference API key (an OpenRouter key, "sk-or-v1-...").
# Both the generator's OpenAI client and Harbor's LiteLLM read it.
OPENROUTER_API_KEY=

# OpenAI-compatible gateway the key belongs to. Harbor routes any
# "openrouter/..." model (e.g. openrouter/anthropic/claude-opus-4.8) here.
# The README mentions https://api.aqinference.com/v1, but the issued key
# authenticates against OpenRouter directly.
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional overrides (defaults live in generator/config.py):
# GENERATOR_MODEL=anthropic/claude-sonnet-4.6
# EVAL_AGENT=terminus-2
# EVAL_MODEL=openrouter/anthropic/claude-opus-4.8
# N_RUNS=5
