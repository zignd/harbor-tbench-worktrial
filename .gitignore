# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets / environment
.env

# OS
.DS_Store

# Harbor run outputs (written by `harbor run`)
jobs/
trials/
.harbor/
dist.tar.gz

# Research PDFs (re-download from the arXiv links in docs/research/README.md)
docs/research/*.pdf

# Dev-mode pipeline output (DEV_MODE=1); never shipped
output-dev/

# Published Terminal-Bench tasks used only as a novelty reference (make tb-reference)
data/tb-reference/

# Third-party code and build output inside candidate packages: not written by the
# generator, reproducible from the package's lockfiles, and large (a vendored Rust
# crate tree was 68 MB). The authored package itself stays committed as evidence.
runs/candidates/**/node_modules/
runs/candidates/**/vendor/
runs/candidates/**/target/
runs/candidates/**/__pycache__/
