#!/usr/bin/env python3
import sys, ipaddress

def classify(value):
    value = value.strip()
    try:
        if '%' in value:
            base, zone = value.split('%', 1)
            ip = ipaddress.ip_address(base)
            canonical = ip.compressed + '%' + zone.lower()
        else:
            ip = ipaddress.ip_address(value)
            canonical = ip.compressed
        if ip.version == 6 and ip.ipv4_mapped:
            return 'mapped\t::ffff:' + str(ip.ipv4_mapped)
        if ip.is_loopback or ip.is_private or ip.is_link_local:
            kind = 'private'
        elif ip.is_global:
            kind = 'public'
        else:
            kind = 'special'
        return kind + '\t' + canonical
    except Exception:
        return 'unknown\t' + value

for raw in sys.stdin:
    if raw.endswith('\n'):
        raw = raw[:-1]
    print(classify(raw), flush=True)
