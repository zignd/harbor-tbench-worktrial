#!/usr/bin/env python3
import sqlite3,sys
try:
 c=sqlite3.connect('/work/state/events.sqlite'); names={r[0] for r in c.execute("select name from sqlite_master where type='table'")}
 need={'events','rejections','daily_summary','actor_summary','indicator_summary','metadata'}
 assert need <= names and c.execute('pragma foreign_key_check').fetchall()==[]
 assert c.execute('select count(*) from events').fetchone()[0] == int(c.execute("select value from metadata where key='accepted'").fetchone()[0])
except Exception: sys.exit(1)
