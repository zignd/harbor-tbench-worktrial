#!/usr/bin/env python3
import sys, ipaddress

def classify(text):
    try:
        zone = ''
        raw = text
        if '%' in raw:
            raw, zone = raw.split('%', 1)
        ip = ipaddress.ip_address(raw)
        if isinstance(ip, ipaddress.IPv6Address) and ip.ipv4_mapped:
            return '::ffff:' + str(ip.ipv4_mapped) + '\tmapped'
        if isinstance(ip, ipaddress.IPv6Address):
            return ip.compressed + (('%' + zone) if zone else '') + '\t' + ('' if zone else ('private6' if ip.is_private else 'global6'))
        return str(ip) + '\t' + ('private4' if ip.is_private else 'global4')
    except Exception:
        return text + '\tunknown'
for line in sys.stdin.buffer:
    try:
        sys.stdout.write(classify(line.decode('utf-8').rstrip('\n')) + '\n')
    except Exception:
        sys.stdout.write('\tunknown\n')
    sys.stdout.flush()
