#!/usr/bin/env python3
import sqlite3,sys
try:
 c=sqlite3.connect('/work/state/events.sqlite'); required={'events','rejections','daily_summary','actor_summary','indicator_summary','metadata'}
 names={r[0] for r in c.execute("select name from sqlite_master where type='table'")}
 assert required<=names
 assert c.execute('pragma integrity_check').fetchone()[0]=='ok'
 assert c.execute('select count(*) from events').fetchone()[0]>=0
 assert c.execute('select count(*) from daily_summary').fetchone()[0]==c.execute('select count(distinct substr(timestamp,1,10)) from events').fetchone()[0]
 print('OK')
except Exception as e:
 print('INVALID',e); sys.exit(1)
