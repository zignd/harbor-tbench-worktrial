#!/usr/bin/env python3
import csv,json,os,sqlite3,sys
from pathlib import Path

def main():
    inp,out=map(Path,sys.argv[1:]); out.mkdir(parents=True,exist_ok=True)
    rows=[]; bad=[]
    for p in inp.rglob('*.log'):
      if not p.is_file(): continue
      for n,line in enumerate(p.read_text(errors='replace').splitlines(),1):
       try:
        x=json.loads(line)
        if not isinstance(x,dict): raise ValueError('object')
        need=['event_id','ts_ms','tenant','session','op','latency_us','status']
        if any(k not in x for k in need): raise ValueError('keys')
        rows.append((x,p.relative_to(inp).as_posix(),n))
       except Exception as e: bad.append((p.relative_to(inp).as_posix(),n,'invalid_json'))
    rows.sort(key=lambda z:(z[0].get('ts_ms',0),z[1]))
    seen=set(); rows=[r for r in rows if not (r[0].get('event_id') in seen or seen.add(r[0].get('event_id')))]
    with open(out/'events.csv','w',newline='') as f:
      w=csv.writer(f);w.writerow(['event_id','ts_ms','tenant','session','op','latency_us','status','relative_filename','physical_line'])
      for x,p,n in rows:w.writerow([x[k] for k in ['event_id','ts_ms','tenant','session','op','latency_us','status']]+[p,n])
    with open(out/'rejects.csv','w',newline='') as f:
      w=csv.writer(f);w.writerow(['relative_filename','physical_line','reason']);w.writerows(bad)
    for name,head in [('sessions.csv',['tenant','session','start_ms','finish_ms','event_count','error_count','duration_ms']),('metrics.csv',['tenant','op','event_count','ok_count','fail_count','latency_sum_us','latency_max_us','p95_latency_us'])]:
      with open(out/name,'w',newline='') as f:csv.writer(f).writerow(head)
if __name__=='__main__':main()
