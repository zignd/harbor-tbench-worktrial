#!/usr/bin/env python3
import os,sys,json,subprocess,tempfile
state=sys.argv[1] if len(sys.argv)>1 else '/opt/beacon/state'; data=sys.argv[2] if len(sys.argv)>2 else '/opt/beacon/data';os.makedirs(state,exist_ok=True)
allr=[];rej=0
for fn in sorted(os.listdir(data)):
 if fn.endswith('.cap'):
  p=subprocess.run(['/opt/beacon/bin/frame-decoder'],stdin=open(os.path.join(data,fn)),text=True,capture_output=True)
  for line in p.stdout.splitlines():
   x=json.loads(line)
   if 'rejected' in x: rej+=1
   else: allr.append(x)
groups={}
for x in allr:
 k=(x['device'],x['at']); old=groups.get(k)
 if old is None or (x['quality'],x['source_sequence'])>(old['quality'],old['source_sequence']): groups[k]=x
records=list(groups.values())
by={}
for x in records: by.setdefault(x['device'],[]).append(x)
records=[]
for d,z in by.items():
 first=min(z,key=lambda x:x['source_sequence'])['source_sequence']
 z.sort(key=lambda x:(((x['source_sequence']-first)&0xffffffff),x['at'],x['source_sequence']))
 records.extend(z)
devices=len({x['device'] for x in records});
json.dump(records,open(os.path.join(state,'snapshot.json'),'w'),separators=(',',':'));json.dump({'devices':devices,'records':len(records),'rejected_frames':rej},open(os.path.join(state,'stats.json'),'w'),separators=(',',':'))
