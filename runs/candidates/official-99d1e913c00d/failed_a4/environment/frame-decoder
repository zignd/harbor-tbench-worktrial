#!/usr/bin/env python3
import sys,json
for line in sys.stdin:
 try:
  x=json.loads(line); d=x['device']; at=x['at']; v=x['value']; q=x['quality']; s=x['source_sequence']
  if not isinstance(d,str) or len(d)!=16 or any(c not in '0123456789abcdefABCDEF' for c in d): raise ValueError()
  if any(not isinstance(x, int) for x in (at,v,q,s)): raise ValueError()
  x['device']=d.upper();x['source_sequence']=s&0xffffffff; print(json.dumps(x,separators=(',',':')))
 except Exception: print(json.dumps({'rejected':1},separators=(',',':')))
