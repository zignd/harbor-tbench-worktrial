#!/usr/bin/env python3
import sys,json
for line in sys.stdin:
 try:
  x=json.loads(line); print(json.dumps({'device':str(x['device']).lower(),'at':int(x['at']),'value':int(x['value']),'quality':int(x['quality']),'source_sequence':int(x.get('source_sequence',x['seq']))&0xffffffff))
 except Exception: pass
