#!/usr/bin/env python3
import sys,os,json,glob
root=sys.argv[1] if len(sys.argv)>1 else '/opt/beacon/data'; out=sys.argv[2] if len(sys.argv)>2 else '/opt/beacon/state'
os.makedirs(out,exist_ok=True); chosen={}; rejected=0
for fn in sorted(glob.glob(os.path.join(root,'*.cap'))):
  try: lines=open(fn,errors='replace')
  except OSError: continue
  for line in lines:
    try:
      x=json.loads(line); d=str(x['device']).lower(); t=int(x['at']); v=int(x['value']); q=int(x['quality']); s=int(x.get('source_sequence',x.get('seq')))&0xffffffff
      if len(d)!=16 or any(c not in '0123456789abcdef' for c in d): raise ValueError()
      r={'device':d,'at':t,'value':v,'quality':q,'source_sequence':s}; k=(d,t); old=chosen.get(k)
      if old is None or (q,s)>=(old['quality'],old['source_sequence']): chosen[k]=r
    except Exception: rejected+=1
rows=sorted(chosen.values(),key=lambda r:(r['device'],r['at'],r['source_sequence']))
json.dump(rows,open(os.path.join(out,'snapshot.json'),'w'),separators=(',',':'))
json.dump({'records':len(rows),'devices':len({r['device'] for r in rows}),'rejected_frames':rejected},open(os.path.join(out,'stats.json'),'w'),separators=(',',':'))
