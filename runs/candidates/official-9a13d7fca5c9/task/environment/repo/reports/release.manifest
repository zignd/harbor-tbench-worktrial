# ordered report manifest
[summary]
query = queries/summary.sql
params = {"needle":"paid"}
sql = """
SELECT id, status, amount FROM events
WHERE status ILIKE $needle ORDER BY id
"""

[broken]
query = queries/broken.sql
sql = """SELECT * FROM absent_table"""

[history]
query = queries/history.sql
params = {"min":0}
sql = """SELECT id, status, amount FROM events WHERE amount >= $min ORDER BY id"""
