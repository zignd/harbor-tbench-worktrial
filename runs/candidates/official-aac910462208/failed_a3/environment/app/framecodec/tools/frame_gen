#!/usr/bin/env python3
import struct, sys, argparse

def make_frame(frame_type, seq, payload_hex):
    payload = bytes.fromhex(payload_hex)
    return struct.pack(">BIH", frame_type, seq, len(payload)) + payload

def main():
    p = argparse.ArgumentParser(description="framecodec test frame generator")
    p.add_argument("--type", type=int, default=1, dest="frame_type")
    p.add_argument("--seq", type=int, default=1)
    p.add_argument("--payload", default="deadbeef")
    p.add_argument("--url", default="http://127.0.0.1:7000")
    args = p.parse_args()
    frame = make_frame(args.frame_type, args.seq, args.payload)
    sys.stdout.buffer.write(frame)

if __name__ == "__main__":
    main()
