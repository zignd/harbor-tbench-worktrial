[package]
name = "packet-codec"
version = "0.3.0"
edition = "2021"
authors = ["platform-team <platform@example.com>"]
description = "High-performance packet encoding/decoding library"

[[bin]]
name = "packet-codec"
path = "src/main.rs"

[lib]
name = "packet_codec"
path = "src/lib.rs"

[dependencies]

[dev-dependencies]
criterion = { version = "0.5", features = ["html_reports"] }

[[bench]]
name = "throughput"
harness = false

[profile.release]
opt-level = 3
lto = true
debug = false
codegen-units = 1
