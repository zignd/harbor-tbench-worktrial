//! Variable-length integer codec (LEB128-style) and packet serialization.
//! This module was refactored for safety during the pipeline migration.

use std::io;

/// Encode a u64 as LEB128 into `buf`. Returns the number of bytes written.
pub fn encode_varint(mut value: u64, buf: &mut Vec<u8>) -> usize {
    let start = buf.len();
    loop {
        let mut byte = (value & 0x7f) as u8;
        value >>= 7;
        if value != 0 {
            byte |= 0x80;
        }
        buf.push(byte);
        if value == 0 {
            break;
        }
    }
    buf.len() - start
}

/// Decode a LEB128-encoded u64 from a byte slice.
/// Returns the decoded value and the number of bytes consumed.
pub fn decode_varint(buf: &[u8]) -> io::Result<(u64, usize)> {
    let mut result: u64 = 0;
    let mut shift = 0u32;
    let mut i = 0usize;
    loop {
        if i >= buf.len() {
            return Err(io::Error::new(io::ErrorKind::UnexpectedEof, "truncated varint"));
        }
        if i >= 10 {
            return Err(io::Error::new(io::ErrorKind::InvalidData, "varint too long"));
        }
        let byte = buf[i];
        i += 1;
        result |= ((byte & 0x7f) as u64) << shift;
        shift += 7;
        if byte & 0x80 == 0 {
            break;
        }
    }
    Ok((result, i))
}

/// A packet: a type tag plus a raw payload.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Packet {
    pub tag: u8,
    pub payload: Vec<u8>,
}

impl Packet {
    pub fn new(tag: u8, payload: Vec<u8>) -> Self {
        Packet { tag, payload }
    }

    /// Encode the packet into a byte buffer.
    pub fn encode(&self, buf: &mut Vec<u8>) {
        buf.push(self.tag);
        encode_varint(self.payload.len() as u64, buf);
        buf.extend_from_slice(&self.payload);
    }

    /// Decode a packet from a byte slice, returning the packet and bytes consumed.
    pub fn decode(buf: &[u8]) -> io::Result<(Packet, usize)> {
        if buf.is_empty() {
            return Err(io::Error::new(io::ErrorKind::UnexpectedEof, "empty buffer"));
        }
        let tag = buf[0];
        let (payload_len, varint_bytes) = decode_varint(&buf[1..])?;
        let payload_len = payload_len as usize;
        let header_len = 1 + varint_bytes;
        if buf.len() < header_len + payload_len {
            return Err(io::Error::new(
                io::ErrorKind::UnexpectedEof,
                format!("need {} bytes, have {}", header_len + payload_len, buf.len()),
            ));
        }
        let payload = buf[header_len..header_len + payload_len].to_vec();
        Ok((Packet { tag, payload }, header_len + payload_len))
    }
}

/// Encode multiple packets into a single buffer.
pub fn encode_batch(packets: &[Packet], buf: &mut Vec<u8>) {
    for p in packets {
        p.encode(buf);
    }
}

/// Decode all packets from a buffer.
pub fn decode_batch(mut buf: &[u8]) -> io::Result<Vec<Packet>> {
    let mut packets = Vec::new();
    while !buf.is_empty() {
        let (pkt, consumed) = Packet::decode(buf)?;
        packets.push(pkt);
        buf = &buf[consumed..];
    }
    Ok(packets)
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn varint_roundtrip_small() {
        for v in [0u64, 1, 127, 128, 255, 16383, 16384, u32::MAX as u64] {
            let mut buf = Vec::new();
            encode_varint(v, &mut buf);
            let (decoded, _) = decode_varint(&buf).unwrap();
            assert_eq!(v, decoded, "varint roundtrip failed for {}", v);
        }
    }

    #[test]
    fn packet_roundtrip_127_bytes() {
        let payload = vec![0xabu8; 127];
        let pkt = Packet::new(0x01, payload);
        let mut buf = Vec::new();
        pkt.encode(&mut buf);
        let (decoded, _) = Packet::decode(&buf).unwrap();
        assert_eq!(pkt, decoded);
    }

    #[test]
    fn packet_roundtrip_various() {
        for len in [1usize, 7, 13, 31, 63, 100, 200, 500, 1000] {
            let payload: Vec<u8> = (0..len).map(|i| (i * 7 + 3) as u8).collect();
            let pkt = Packet::new(0x02, payload);
            let mut buf = Vec::new();
            pkt.encode(&mut buf);
            let (decoded, _) = Packet::decode(&buf).unwrap();
            assert_eq!(pkt, decoded, "roundtrip failed for len={}", len);
        }
    }
}
