//! Protocol constants and message type definitions.

/// Protocol version identifier.
pub const PROTO_VERSION: u8 = 2;

/// Known message type tags.
#[repr(u8)]
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum MessageType {
    Heartbeat = 0x01,
    DataPacket = 0x02,
    Ack = 0x03,
    Nack = 0x04,
    Control = 0x05,
    Metrics = 0x10,
    Unknown = 0xFF,
}

impl MessageType {
    pub fn from_tag(tag: u8) -> Self {
        match tag {
            0x01 => MessageType::Heartbeat,
            0x02 => MessageType::DataPacket,
            0x03 => MessageType::Ack,
            0x04 => MessageType::Nack,
            0x05 => MessageType::Control,
            0x10 => MessageType::Metrics,
            _ => MessageType::Unknown,
        }
    }

    pub fn is_data(&self) -> bool {
        matches!(self, MessageType::DataPacket | MessageType::Metrics)
    }

    pub fn requires_ack(&self) -> bool {
        matches!(self, MessageType::DataPacket | MessageType::Control)
    }
}

/// Maximum allowed payload size (bytes).
pub const MAX_PAYLOAD_SIZE: usize = 65535;

/// Minimum frame size (header only, empty payload).
pub const MIN_FRAME_SIZE: usize = 6; // 4-byte length + 1-byte tag + 1-byte varint

/// Pipeline stage identifiers.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum PipelineStage {
    Ingress,
    Routing,
    Processing,
    Egress,
}

impl PipelineStage {
    pub fn name(&self) -> &'static str {
        match self {
            PipelineStage::Ingress => "ingress",
            PipelineStage::Routing => "routing",
            PipelineStage::Processing => "processing",
            PipelineStage::Egress => "egress",
        }
    }
}

/// Build a heartbeat payload with the given sequence number.
pub fn heartbeat_payload(seq: u32) -> Vec<u8> {
    seq.to_le_bytes().to_vec()
}

/// Parse a heartbeat payload, returning the sequence number.
pub fn parse_heartbeat(payload: &[u8]) -> Option<u32> {
    if payload.len() < 4 {
        return None;
    }
    Some(u32::from_le_bytes([payload[0], payload[1], payload[2], payload[3]]))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn message_type_roundtrip() {
        for tag in [0x01u8, 0x02, 0x03, 0x04, 0x05, 0x10, 0xFF] {
            let mt = MessageType::from_tag(tag);
            assert_ne!(format!("{:?}", mt), "");
        }
    }

    #[test]
    fn heartbeat_roundtrip() {
        for seq in [0u32, 1, 255, 65535, u32::MAX] {
            let payload = heartbeat_payload(seq);
            let parsed = parse_heartbeat(&payload).unwrap();
            assert_eq!(seq, parsed);
        }
    }

    #[test]
    fn pipeline_stage_names() {
        assert_eq!(PipelineStage::Ingress.name(), "ingress");
        assert_eq!(PipelineStage::Egress.name(), "egress");
    }

    #[test]
    fn data_type_classification() {
        assert!(MessageType::DataPacket.is_data());
        assert!(!MessageType::Heartbeat.is_data());
        assert!(MessageType::DataPacket.requires_ack());
        assert!(!MessageType::Heartbeat.requires_ack());
    }
}
