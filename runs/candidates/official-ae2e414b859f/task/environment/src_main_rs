//! packet-codec CLI entry point.

use packet_codec::codec::Packet;
use packet_codec::frame::{write_frames, read_frames};
use packet_codec::stats::PacketStats;
use std::io::{self, Read, Write};

fn main() {
    let args: Vec<String> = std::env::args().collect();
    let mode = args.get(1).map(|s| s.as_str()).unwrap_or("echo");

    match mode {
        "echo" => {
            // Read framed packets from stdin, write them back to stdout.
            let mut input = Vec::new();
            io::stdin().read_to_end(&mut input).expect("read stdin");
            let packets = read_frames(&input).expect("decode frames");
            let mut output = Vec::new();
            write_frames(&packets, &mut output);
            io::stdout().write_all(&output).expect("write stdout");
        }
        "stats" => {
            let mut input = Vec::new();
            io::stdin().read_to_end(&mut input).expect("read stdin");
            let packets = read_frames(&input).expect("decode frames");
            let mut stats = PacketStats::new();
            for p in &packets {
                stats.record_decode(p.payload.len());
            }
            eprintln!(
                "packets={} bytes={} errors={}",
                stats.packets_decoded,
                stats.bytes_decoded,
                stats.errors
            );
        }
        "version" => {
            println!("packet-codec v{}", packet_codec::proto::PROTO_VERSION);
        }
        other => {
            eprintln!("unknown mode: {}", other);
            std::process::exit(1);
        }
    }
}
