//! Packet statistics and accounting helpers.

/// Running statistics for packet processing.
#[derive(Debug, Default, Clone)]
pub struct PacketStats {
    pub packets_encoded: u64,
    pub packets_decoded: u64,
    pub bytes_encoded: u64,
    pub bytes_decoded: u64,
    pub errors: u64,
}

impl PacketStats {
    pub fn new() -> Self {
        PacketStats::default()
    }

    pub fn record_encode(&mut self, payload_len: usize) {
        self.packets_encoded += 1;
        self.bytes_encoded += payload_len as u64;
    }

    pub fn record_decode(&mut self, payload_len: usize) {
        self.packets_decoded += 1;
        self.bytes_decoded += payload_len as u64;
    }

    pub fn record_error(&mut self) {
        self.errors += 1;
    }

    pub fn total_packets(&self) -> u64 {
        self.packets_encoded + self.packets_decoded
    }

    pub fn total_bytes(&self) -> u64 {
        self.bytes_encoded + self.bytes_decoded
    }

    pub fn reset(&mut self) {
        *self = PacketStats::default();
    }
}

/// Compute a simple checksum over a byte slice (XOR-based, for integrity checks).
pub fn simple_checksum(data: &[u8]) -> u8 {
    data.iter().fold(0u8, |acc, &b| acc ^ b)
}

/// Histogram bucket for payload size distribution.
#[derive(Debug, Clone)]
pub struct SizeHistogram {
    buckets: Vec<u64>,
    bucket_width: usize,
}

impl SizeHistogram {
    pub fn new(num_buckets: usize, bucket_width: usize) -> Self {
        SizeHistogram {
            buckets: vec![0u64; num_buckets],
            bucket_width,
        }
    }

    pub fn record(&mut self, size: usize) {
        let idx = (size / self.bucket_width).min(self.buckets.len() - 1);
        self.buckets[idx] += 1;
    }

    pub fn get_bucket(&self, idx: usize) -> u64 {
        self.buckets.get(idx).copied().unwrap_or(0)
    }

    pub fn total(&self) -> u64 {
        self.buckets.iter().sum()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn stats_encode_decode() {
        let mut s = PacketStats::new();
        s.record_encode(100);
        s.record_decode(100);
        assert_eq!(s.packets_encoded, 1);
        assert_eq!(s.packets_decoded, 1);
        assert_eq!(s.total_bytes(), 200);
    }

    #[test]
    fn checksum_empty() {
        assert_eq!(simple_checksum(&[]), 0);
    }

    #[test]
    fn checksum_known() {
        assert_eq!(simple_checksum(&[0xAB, 0xCD, 0xEF]), 0xAB ^ 0xCD ^ 0xEF);
    }

    #[test]
    fn histogram_buckets() {
        let mut h = SizeHistogram::new(10, 128);
        h.record(0);
        h.record(127);
        h.record(128);
        h.record(256);
        assert_eq!(h.get_bucket(0), 2);
        assert_eq!(h.get_bucket(1), 1);
        assert_eq!(h.get_bucket(2), 1);
        assert_eq!(h.total(), 4);
    }
}
