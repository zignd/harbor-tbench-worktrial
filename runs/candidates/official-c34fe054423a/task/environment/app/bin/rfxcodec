#!/usr/bin/env python3
import sys

def enc(x):
    x=(x<<1)^(x>>63)
    if x<0:x=(x<<1)^(x>>1000)
    out=bytearray()
    while x>127:out.append((x&127)|128);x>>=7
    out.append(x);return bytes(out)
for line in sys.stdin:
    try:
        x=int(line.strip(),16); print(enc(x).hex())
    except Exception: print('error')
