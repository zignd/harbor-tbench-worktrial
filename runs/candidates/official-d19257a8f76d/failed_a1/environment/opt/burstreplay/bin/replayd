#!/usr/bin/env python3
# Initial implementation retained for repair by the task solver.
import sys,json
state=[]
for line in sys.stdin:
 try:
  q=json.loads(line); op=q['op']; run=q['run']
  if op=='reset': state=[]; a={'ok':True,'op':'reset','run':run}
  elif op=='ingest': state += [x for x in q.get('trace','').splitlines() if x]; a={'ok':True,'op':'ingest','run':run,'ingested':len(state)}
  elif op=='report': a={'ok':True,'op':'report','run':run,'events':len(state),'sessions':1 if state else 0,'units':0,'peak':0,'histogram':{'%d'%len(state):1} if state else {},'checksum':'00000000'}
  else: a={'ok':False,'error':'invalid_request'}
  print(json.dumps(a,separators=(',',':')),flush=True)
 except Exception: print(json.dumps({'ok':False,'error':'invalid_request'}),flush=True)
