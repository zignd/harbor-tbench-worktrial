#!/usr/bin/env python3
import sys,json,zlib,csv,io
runs={}
def err(kind,line=None):
 d={'ok':False,'error':kind}
 if line is not None:d['line']=line
 return d
def split_records(s):
 out=[]; buf=''; quoted=False; esc=False
 for ch in s:
  if ch=='"' and not esc: quoted=not quoted
  if ch=='\\' and not esc: esc=True
  else: esc=False
  buf+=ch
  if ch=='\n' and not quoted: out.append(buf[:-1]);buf=''
 if buf: out.append(buf)
 if quoted: raise ValueError('unterminated_quote')
 return out
def decode(line):
 # CSV handles quoted newlines; first transform escaped pipes into a safe placeholder.
 chars=[]; i=0; quoted=False
 while i<len(line):
  c=line[i]
  if c=='\\' and i+1<len(line) and line[i+1]=='|': chars.extend(['\x00']);i+=2;continue
  if c=='\\' and i+1<len(line) and line[i+1]=='\\': chars.extend(['\x01']);i+=2;continue
  chars.append(c);i+=1
 row=next(csv.reader([ ''.join(chars)],delimiter='|',quotechar='"',doublequote=True,strict=True))
 row=[x.replace('\x00','|').replace('\x01','\\') for x in row]
 if len(row)!=6 or not row[0].isdigit() or not row[2].isdigit() or not row[3].isdigit() or len(row[5])!=8: raise ValueError('invalid_record')
 raw='|'.join(row[:5]).encode();
 if zlib.crc32(raw)&0xffffffff != int(row[5],16): raise ValueError('checksum')
 return (int(row[0]),int(row[2]),int(row[3]))
def report(run):
 a=sorted(runs.get(run,[]),key=lambda x:(x[0],x[3])); sessions=[]
 for x in a:
  if not sessions or x[0]-sessions[-1][-1][0]>60000:sessions.append([])
  sessions[-1].append(x)
 hist={};units=peak=0
 for ss in sessions:
  hist[str(len(ss))]=hist.get(str(len(ss)),0)+1
  for t,v,w,i in ss: units+=v*w;peak=max(peak,v*w)
 d={'op':'report','run':run,'events':len(a),'sessions':len(sessions),'units':units,'peak':peak,'histogram':hist}
 d['checksum']=f"{zlib.crc32(json.dumps(d,sort_keys=True,separators=(',',':')).encode())&0xffffffff:08x}"
 d['ok']=True
 return d
def main():
 for raw in sys.stdin:
  try:
   q=json.loads(raw); op=q.get('op'); run=q.get('run')
   if not isinstance(run,str) or op not in ('reset','ingest','report'): raise ValueError('invalid_request')
   if op=='reset': runs.pop(run,None); ans={'ok':True,'op':'reset','run':run}
   elif op=='report': ans=report(run); 
   else:
    if not isinstance(q.get('trace'),str): raise ValueError('invalid_request')
    arr=runs.setdefault(run,[]); start=len(arr); n=0
    for ln,line in enumerate(split_records(q['trace']),1):
     try:
      t,v,w=decode(line);arr.append((t,v,w,start+n));n+=1
     except Exception:
      ans=err('invalid_record',ln)
      break
    else: ans={'ok':True,'op':'ingest','run':run,'ingested':n}
   if 'ans' in locals(): print(json.dumps(ans,ensure_ascii=False,separators=(',',':')),flush=True);del ans
  except Exception as e: print(json.dumps(err(str(e) if str(e) in ('invalid_request','unterminated_quote') else 'invalid_request'),separators=(',',':')),flush=True)
if __name__=='__main__':main()
