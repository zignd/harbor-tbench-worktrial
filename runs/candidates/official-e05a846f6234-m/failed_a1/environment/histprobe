#!/usr/bin/env python3
import json,sys
for line in sys.stdin:
 try:
  x=json.loads(line); a=[]
  for v,w in x.get('values',[]): a.extend([float(v)]*int(w))
  a.sort(); q=float(x.get('q',.5)); y=None if not a else a[min(len(a)-1,max(0,int(q*(len(a)-1))))]
  print(json.dumps({'percentile':y},separators=(',',':')))
 except Exception: print('{"error":"invalid"}')
