#!/usr/bin/env python3
import sys,json,math
EVENTS={}
def report(q):
    es=[e for e in EVENTS.values() if e.get('assay')==q.get('assay') and e.get('delivered_at','')<=q.get('as_of','')]
    removed={e.get('supersedes') for e in es if e.get('supersedes')}
    es=[e for e in es if e.get('event_id') not in removed]
    if not es:
        return {'ok':True,'assay':q.get('assay'),'as_of':q.get('as_of'),'count':0,'slope':0.0,'intercept':0.0,'residual_scale':0.0,'predictions':[{'x':x,'y':0.0,'uncertainty':0.0} for x in q.get('predict',[])]}
    weights=[1.0/(e['stderr']*e['stderr']) for e in es]
    sw=sum(weights); sx=sum(e['x']*w for e,w in zip(es,weights)); sy=sum(e['y']*w for e,w in zip(es,weights)); sxx=sum(e['x']*e['x']*w for e,w in zip(es,weights)); sxy=sum(e['x']*e['y']*w for e,w in zip(es,weights)); det=sw*sxx-sx*sx
    slope=sxy/det if det else 0.0; intercept=(sy-slope*sx)/sw
    rss=sum(w*(e['y']-intercept-slope*e['x'])**2 for e,w in zip(es,weights)); scale=math.sqrt(rss/max(1,len(es)-2))
    return {'ok':True,'assay':q.get('assay'),'as_of':q.get('as_of'),'count':len(es),'slope':slope,'intercept':intercept,'residual_scale':scale,'predictions':[{'x':x,'y':intercept+slope*x,'uncertainty':scale} for x in q.get('predict',[])]}
for line in sys.stdin:
    try:
        q=json.loads(line); op=q.get('op')
        if op=='health': out={'ok':True,'service':'assayd'}
        elif op=='append': EVENTS[q['event']['event_id']]=q['event']; out={'ok':True,'event_id':q['event']['event_id']}
        elif op=='replay':
            for e in q.get('events',[]): EVENTS[e['event_id']]=e
            out={'ok':True,'count':len(q.get('events',[]))}
        elif op=='calibration_report': out=report(q)
        else: out={'ok':False,'error':'invalid request'}
        print(json.dumps(out,separators=(',',':'),allow_nan=False),flush=True)
    except Exception:
        print('{"ok":false,"error":"invalid request"}',flush=True)
