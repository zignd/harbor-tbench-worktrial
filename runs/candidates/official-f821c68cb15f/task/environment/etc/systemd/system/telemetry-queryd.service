[Unit]
Description=Telemetry Log Attribution and Metric Query Service
After=network.target

[Service]
Type=forking
PIDFile=/var/run/telemetry-queryd.pid
ExecStart=/opt/telemetry-service/run.sh start
ExecStop=/opt/telemetry-service/run.sh stop
ExecReload=/opt/telemetry-service/run.sh restart
Restart=on-failure
User=root
WorkingDirectory=/opt/telemetry-service

[Install]
WantedBy=multi-user.target
