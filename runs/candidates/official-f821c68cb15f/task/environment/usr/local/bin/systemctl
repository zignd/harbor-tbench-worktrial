#!/bin/bash
ACTION="$1"
SERVICE="$2"

# Strip .service suffix if present
SERVICE="${SERVICE%.service}"

if [ "$SERVICE" = "telemetry-queryd" ]; then
    case "$ACTION" in
        start)
            /opt/telemetry-service/run.sh start
            ;;
        stop)
            /opt/telemetry-service/run.sh stop
            ;;
        restart)
            /opt/telemetry-service/run.sh restart
            ;;
        status)
            /opt/telemetry-service/run.sh status
            ;;
        is-active)
            /opt/telemetry-service/run.sh status > /dev/null 2>&1
            ;;
        *)
            echo "Action $ACTION not supported" >&2
            exit 1
            ;;
    esac
else
    echo "Service $SERVICE not found" >&2
    exit 1
fi
