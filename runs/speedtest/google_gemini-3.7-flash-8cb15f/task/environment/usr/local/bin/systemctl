#!/bin/bash
cmd="$1"
service="$2"
if [ "$service" = "telemetry-queryd" ] || [ "$service" = "telemetry-queryd.service" ]; then
    case "$cmd" in
        start|restart|stop|status)
            /opt/telemetry-service/run.sh "$cmd"
            ;;
        daemon-reload|enable|disable)
            exit 0
            ;;
        *)
            /opt/telemetry-service/run.sh "$cmd"
            ;;
    esac
else
    if [ -x /bin/systemctl.real ]; then
        exec /bin/systemctl.real "$@"
    fi
fi
