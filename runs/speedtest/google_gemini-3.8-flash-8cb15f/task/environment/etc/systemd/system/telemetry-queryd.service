[Unit]
Description=Telemetry Session Attribution and Query Daemon
After=network.target

[Service]
Type=forking
ExecStart=/opt/telemetry-service/run.sh start
ExecStop=/opt/telemetry-service/run.sh stop
ExecReload=/opt/telemetry-service/run.sh restart
PIDFile=/run/telemetry-queryd.pid
Restart=always
User=root

[Install]
WantedBy=multi-user.target
