#!/bin/bash
CMD="$1"
UNIT="$2"

if [ "$UNIT" = "telemetry-queryd" ] || [ "$UNIT" = "telemetry-queryd.service" ]; then
    case "$CMD" in
        start)
            /opt/telemetry-service/run.sh start
            ;;
        stop)
            /opt/telemetry-service/run.sh stop
            ;;
        restart)
            /opt/telemetry-service/run.sh restart
            ;;
        status)
            /opt/telemetry-service/run.sh status
            ;;
        *)
            echo "Unknown systemctl command: $CMD" >&2
            exit 1
            ;;
    esac
else
    echo "Unit $UNIT not managed by minimal systemctl shim" >&2
    exit 1
fi
