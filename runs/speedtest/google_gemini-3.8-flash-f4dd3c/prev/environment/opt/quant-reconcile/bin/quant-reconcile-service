#!/usr/bin/env bash
# Quantitative Risk Simulation - Reconciler Service Daemon / Runner
# Manages scheduled and on-demand reconciliation cycles.

set -eo pipefail

CONFIG_FILE="/etc/quant-reconcile/reconcile.env"
if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
fi

RECONCILE_BIN="/opt/quant-reconcile/bin/reconcile_all.sh"
PIDFILE="/var/run/quant-reconcile.pid"
BATCH_DIR=""
RUN_ONCE=1
STATUS_MODE=0

usage() {
    cat << USG
Usage: $0 [OPTIONS]

Options:
  --batch-dir <DIR>   Specify spool directory to reconcile (defaults to SPOOL_DIR)
  --status            Display status of service and ledger database
  --help, -h          Show this help message
USG
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --batch-dir)
            BATCH_DIR="$2"
            shift 2
            ;;
        --status)
            STATUS_MODE=1
            shift
            ;;
        -h|--help)
            usage
            ;;
        *)
            echo "[ERROR] Unknown argument: $1" >&2
            usage
            ;;
    esac
done

if [[ "$STATUS_MODE" -eq 1 ]]; then
    DB="${DB_PATH:-/var/lib/quant-reconcile/reconcile.db}"
    echo "[INFO] Quant Reconciler Service Status:"
    if [[ -f "$DB" ]]; then
        echo "Database: $DB (exists)"
        sqlite3 "$DB" "PRAGMA integrity_check;" || echo "Integrity check failed"
        TOTAL_BATCHES=$(sqlite3 "$DB" "SELECT COUNT(*) FROM batch_reconcile;" 2>/dev/null || echo 0)
        TOTAL_ANOMALIES=$(sqlite3 "$DB" "SELECT COUNT(*) FROM anomaly_records;" 2>/dev/null || echo 0)
        echo "Total batches reconciled: $TOTAL_BATCHES"
        echo "Total anomalies recorded: $TOTAL_ANOMALIES"
    else
        echo "Database: $DB (NOT FOUND)"
    fi
    exit 0
fi

TARGET_DIR="${BATCH_DIR:-$SPOOL_DIR}"
if [[ -z "$TARGET_DIR" ]]; then
    TARGET_DIR="/var/spool/quant-reconcile/incoming"
fi

if [[ ! -d "$TARGET_DIR" ]]; then
    echo "[ERROR] Target batch directory does not exist: $TARGET_DIR" >&2
    exit 1
fi

echo "[INFO] quant-reconcile-service starting reconciliation run on $TARGET_DIR..."
"$RECONCILE_BIN" --batch-dir "$TARGET_DIR"
SERVICE_EXIT=$?

if [[ "$SERVICE_EXIT" -eq 0 ]]; then
    echo "[INFO] quant-reconcile-service cycle finished cleanly."
else
    echo "[ERROR] quant-reconcile-service encountered an error (exit $SERVICE_EXIT)." >&2
fi

exit "$SERVICE_EXIT"
