# Monte Carlo Risk Reconciliation Environment Configuration

DB_PATH="/var/lib/quant-reconcile/reconcile.db"

# SQLite Concurrency & Pragma Settings
# WARNING: Staging orchestrator crashes under load with current settings
SQLITE_JOURNAL_MODE="MEMORY"
SQLITE_BUSY_TIMEOUT=0
SQLITE_SYNCHRONOUS="OFF"

# Anomaly Detection Bounds
MAX_DRIFT=0.0350
VAR_LIMIT=0.0500

# Concurrency and Spool Paths
MAX_WORKERS=4
SPOOL_DIR="/var/spool/quant-reconcile/incoming"
STAGING_DIR="/opt/quant-reconcile/staging"
LOG_DIR="/var/log/quant-reconcile"
