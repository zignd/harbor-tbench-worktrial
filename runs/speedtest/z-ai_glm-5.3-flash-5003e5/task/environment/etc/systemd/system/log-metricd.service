[Unit]
Description=Adaptive logarithmic latency metric service
Documentation=file:/opt/log-metricd/doc/algorithm.md
After=network.target

[Service]
Type=notify
User=metricd
Group=metricd
WorkingDirectory=/opt/log-metricd
ExecStart=/opt/log-metricd/bin/log-metricd --config /etc/log-metricd/config.yaml
Restart=on-failure
RestartSec=1
TimeoutStartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
StandardOutput=append:/var/log/log-metricd/service.log
StandardError=append:/var/log/log-metricd/service.log

[Install]
WantedBy=multi-user.target
