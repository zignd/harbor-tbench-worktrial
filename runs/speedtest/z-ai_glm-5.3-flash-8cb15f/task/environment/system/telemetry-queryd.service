[Unit]
Description=Telemetry session attribution query daemon
After=network.target

[Service]
Type=simple
ExecStart=/opt/telemetry-service/run.sh foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
User=root
WorkingDirectory=/opt/telemetry-service

[Install]
WantedBy=multi-user.target
