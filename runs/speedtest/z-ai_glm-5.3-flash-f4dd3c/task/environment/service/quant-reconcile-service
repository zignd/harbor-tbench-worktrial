#!/bin/bash
# Run the deployed reconciliation worker against one directory of spools.
set -o errtrace
set -o nounset
set -o pipefail

BASE_DIR="${QUANT_BASE_DIR:-/opt/quant-reconcile}"
CONFIG_FILE="${QUANT_CONFIG:-/etc/quant-reconcile/reconcile.env}"
source "${BASE_DIR}/lib/common.sh"
source "${CONFIG_FILE}"

BATCH_DIR=""
DATABASE_FILE="${QUANT_DATABASE:-/var/lib/quant-reconcile/reconcile.db}"

usage() {
    printf 'usage: %s --batch-dir DIR [--database FILE]\n' "$0"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --batch-dir)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            BATCH_DIR="$2"
            shift 2
            ;;
        --database)
            [[ $# -ge 2 ]] || { usage >&2; exit 2; }
            DATABASE_FILE="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'unknown service option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

[[ -n "${BATCH_DIR}" ]] || { usage >&2; exit 2; }
[[ -d "${BATCH_DIR}" ]] || quant_die "batch directory is missing" "${BATCH_DIR}"
[[ -d "$(dirname "${DATABASE_FILE}")" ]] || quant_die "database directory is missing" "$(dirname "${DATABASE_FILE}")"
BATCH_DIR="$(readlink -f -- "${BATCH_DIR}")"
DATABASE_FILE="$(readlink -f -- "${DATABASE_FILE}")"

"${BASE_DIR}/bin/reconcile_all.sh" \
    --source "${BATCH_DIR}" \
    --database "${DATABASE_FILE}"

INTEGRITY="$(sqlite3 "${DATABASE_FILE}" 'PRAGMA integrity_check;' 2>&1)"
[[ "${INTEGRITY}" == "ok" ]] || quant_die "SQLite integrity verification failed" "${INTEGRITY}"
printf 'SERVICE_STATUS=OK\n'
